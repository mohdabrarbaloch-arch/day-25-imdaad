# Imdaad — environment configuration
# Copy to .env and fill in real values. NEVER commit .env.

# Secret key for JWT signing — use a long random string in production
SECRET_KEY=change-me-to-a-long-random-string

# JWT expiry in minutes (default 1440 = 24h)
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database URL — SQLite for dev, Postgres in Docker/production
DATABASE_URL=sqlite:///./imdaad.db
# DATABASE_URL=postgresql+psycopg2://imdaad:imdaad@db:5432/imdaad

# Comma-separated list of allowed CORS origins
CORS_ORIGINS=http://localhost:8000,http://localhost:3000

# Rate limits (slowapi format)
RATE_LIMIT_REGISTER=5/minute
RATE_LIMIT_LOGIN=10/minute
RATE_LIMIT_REQUESTS=20/minute

# Blood request auto-expiry window (hours)
REQUEST_EXPIRY_HOURS=72
